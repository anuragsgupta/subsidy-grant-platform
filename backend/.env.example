# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection (Supabase in cloud, postgres:15 in Docker/Testcontainers)
DB_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# ── JWT (D-03: self-issued HS256) ─────────────────────────────────────────────
# Must be a base64-encoded secret of ≥ 256 bits (32+ random bytes)
JWT_SECRET=your_jwt_secret_base64_encoded_here

# ── PII Encryption (REQ-BEN-01, D-06) ────────────────────────────────────────
# AES-256-GCM key for bank account number encryption (32-byte base64-encoded key)
PII_ENCRYPTION_KEY=your_aes256_encryption_key_base64_here

# HMAC-SHA-256 key for national ID hashing (D-06)
NATIONAL_ID_HASH_KEY=your_hmac_national_id_key_here

# ── File Storage (S3-compatible via StoragePort) ──────────────────────────────
# Supabase Storage in cloud; MinIO in Docker Compose
STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1
STORAGE_ACCESS_KEY=your_storage_access_key_here
STORAGE_SECRET_KEY=your_storage_secret_key_here
STORAGE_BUCKET=gsdts-documents

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── External Integrations ─────────────────────────────────────────────────────
# Treasury API (REQ-DSB-03, REQ-INT-*)
TREASURY_BASE_URL=https://treasury.example.gov.in/api/v1
TREASURY_API_KEY_HASH=bcrypt_hash_of_treasury_api_key_here

# Beneficiary Registry API (REQ-BEN-01, AC-BEN-01.7)
BENEFICIARY_DB_API_KEY_HASH=bcrypt_hash_of_beneficiary_db_api_key_here
